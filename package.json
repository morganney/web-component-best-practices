{
  "name": "web-component-best-practices",
  "version": "1.1.0",
  "description": "Best practices for architecting, developing, building, and publishing HTML custom elements with minimal dependencies and a quality developer experience.",
  "type": "module",
  "exports": {
    ".": "./example/src/element.js",
    "./defined.js": "./example/src/defined.js"
  },
  "scripts": {
    "prettier": "prettier . -w",
    "example": "http-server ./example",
    "dev": "vite",
    "build": "vite build && node scripts/copy-example-static.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:style": "stylelint **/*.css",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morganney/web-component-best-practices.git"
  },
  "keywords": [
    "html",
    "custom element",
    "cdn",
    "best practices",
    "developer experience"
  ],
  "author": "Morgan Ney <morganney@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/morganney/web-component-best-practices/issues"
  },
  "homepage": "https://github.com/morganney/web-component-best-practices#readme",
  "files": [
    "example/**"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.61.0",
    "eslint": "^10.4.0",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.6.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.0.14",
    "vite-plugin-html": "^3.2.2"
  },
  "prettier": {
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "printWidth": 120,
    "semi": false,
    "singleQuote": true
  },
  "lint-staged": {
    "*.{js,html,css}": [
      "prettier --write"
    ],
    "*.{js,html}": [
      "eslint --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  }
}
